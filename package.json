{
  "name": "@forjio/plugipay-node",
  "version": "0.10.0",
  "description": "Official Node.js SDK for Plugipay — hosted checkout, subscriptions, invoices, receipts, refunds, gift cards & store credit, webhooks, adapters (Xendit/PayPal/Midtrans/Manual), templates, uploads, workspaces, API keys, billing, account management, admin portal. Platform-partner mode for Storlaunch/Fulkruma/Ripllo.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "payments",
    "plugipay",
    "forjio",
    "checkout",
    "subscriptions",
    "indonesia"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hachimi-cat/plugipay-node.git"
  },
  "bugs": {
    "url": "https://github.com/hachimi-cat/plugipay-node/issues"
  },
  "homepage": "https://github.com/hachimi-cat/plugipay-node#readme"
}
